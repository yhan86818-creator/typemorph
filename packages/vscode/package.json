{
  "name": "typemorph-vscode",
  "displayName": "TypeMorph",
  "description": "Schema conversion in your editor — JSON to TypeScript, Zod, Go, and 160+ formats",
  "version": "0.1.1",
  "publisher": "TypeMorph",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Linters", "Other"],
  "keywords": ["json", "typescript", "zod", "schema", "converter", "codegen"],
  "icon": "icon.png",
  "galleryBanner": { "color": "#0A0A0A", "theme": "dark" },
  "repository": { "type": "git", "url": "https://github.com/yhan86818-creator/typemorph" },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "typemorph.convert",
        "title": "TypeMorph: Convert Schema…"
      },
      {
        "command": "typemorph.quality",
        "title": "TypeMorph: Check Schema Quality"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "typemorph.convert",
          "when": "editorTextFocus",
          "group": "typemorph@1"
        },
        {
          "command": "typemorph.quality",
          "when": "editorTextFocus",
          "group": "typemorph@2"
        }
      ],
      "commandPalette": [
        { "command": "typemorph.convert" },
        { "command": "typemorph.quality" }
      ]
    },
    "keybindings": [
      {
        "command": "typemorph.convert",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorTextFocus"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.0",
    "typescript": "^5"
  }
}
