{
  "name": "typeflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "deploy": "next build && npx wrangler pages deploy out --project-name typeflow-pro --branch main --commit-dirty=true",
    "deploy:only": "npx wrangler pages deploy out --project-name typeflow-pro --branch main --commit-dirty=true",
    "deploy:win": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "build:worker": "esbuild server/worker/infer-worker.ts --bundle --platform=node --outfile=dist/worker/infer-worker.js --minify"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.105.4",
    "fast-xml-parser": "^5.7.3",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.38.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "lz-string": "^1.5.0",
    "mermaid": "^11.14.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.0",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6",
    "ts-node": "^10.9.1",
    "esbuild": "^0.28.0"
  }
}
