exports[`Tier2 generators — WITH_NULLS > redux-slice 1`] = `
"// Required dependencies: npm install @reduxjs/toolkit react-redux

import { createSlice, PayloadAction } from '@reduxjs/toolkit';

export interface RootState {
  user_id: string;
  display_name: string;
  bio: string;
  website: string;
  follower_count: number;
  is_verified: boolean;
}

const initialState: RootState = {
  user_id: '',
  display_name: '',
  bio: '',
  website: '',
  follower_count: 0,
  is_verified: false,
};

export const rootSlice = createSlice({
  name: 'root',
  initialState,
  reducers: {
    setRoot: (state, action: PayloadAction<Partial<RootState>>) => {
      return { ...state, ...action.payload };
    },
    resetRoot: () => initialState,
  },
});

export const { setRoot, resetRoot } = rootSlice.actions;
export default rootSlice.reducer;"
`;

