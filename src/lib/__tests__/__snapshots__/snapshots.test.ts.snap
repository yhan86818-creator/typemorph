exports[`Tier2 generators — BASIC input > c 1`] = `
"// C99+ required. cJSON dependency: https://github.com/DaveGamble/cJSON

#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>
/* cJSON — single-header JSON parser: https://github.com/DaveGamble/cJSON */
#include "cJSON.h"

typedef struct {
  char *id;
  char *name;
  char *email;
  int32_t age;
  double score;
  bool active;
} User;

User user_from_json(const char *json_str) {
  User result = {0};
  cJSON *root = cJSON_Parse(json_str);
  if (!root) return result;

  cJSON *_id = cJSON_GetObjectItemCaseSensitive(root, "id");
  if (cJSON_IsString(_id)) result.id = _id->valuestring;
  cJSON *_name = cJSON_GetObjectItemCaseSensitive(root, "name");
  if (cJSON_IsString(_name)) result.name = _name->valuestring;
  cJSON *_email = cJSON_GetObjectItemCaseSensitive(root, "email");
  if (cJSON_IsString(_email)) result.email = _email->valuestring;
  cJSON *_age = cJSON_GetObjectItemCaseSensitive(root, "age");
  if (cJSON_IsNumber(_age)) result.age = (int32_t)_age->valuedouble;
  cJSON *_score = cJSON_GetObjectItemCaseSensitive(root, "score");
  if (cJSON_IsNumber(_score)) result.score = _score->valuedouble;
  cJSON *_active = cJSON_GetObjectItemCaseSensitive(root, "active");
  if (cJSON_IsBool(_active)) result.active = cJSON_IsTrue(_active);

  cJSON_Delete(root);
  return result;
}"
`;

exports[`Tier2 generators — BASIC input > cpp 1`] = `
"// C++17 required. nlohmann/json: https://github.com/nlohmann/json

#include <string>
#include <cstdint>
/* nlohmann/json — header-only JSON: https://github.com/nlohmann/json */
#include <nlohmann/json.hpp>

struct User {
  std::string id;
  std::string name;
  std::string email;
  int64_t age;
  double score;
  bool active;

  static User from_json(const nlohmann::json& j) {
    User obj;
    obj.id = j.at("id").get<std::string>();
    obj.name = j.at("name").get<std::string>();
    obj.email = j.at("email").get<std::string>();
    obj.age = j.at("age").get<int64_t>();
    obj.score = j.at("score").get<double>();
    obj.active = j.at("active").get<bool>();
    return obj;
  }

  nlohmann::json to_json() const {
    return {
      {"id", id},
      {"name", name},
      {"email", email},
      {"age", age},
      {"score", score},
      {"active", active},
    };
  }
};"
`;

