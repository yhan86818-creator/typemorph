"# Required dependencies: Ecto (mix ecto)

defmodule MyApp.Root do
  use Ecto.Schema
  import Ecto.Changeset

  schema "roots" do
    field :id, :string
    field :name, :string
    field :email, :string
    field :age, :float
    field :score, :float
    field :active, :boolean
    timestamps()
  end

  def changeset(struct, params \\\\ %{}) do
    struct
    |> cast(params, [:id, :name, :email, :age, :score, :active])
    |> validate_required([:id, :name, :email, :age, :score, :active])
  end
end"
`;

exports[`Tier2 generators — BASIC input > elm 1`] = `
"-- Required Elm packages:
-- elm install elm/json
-- elm install elm-community/json-extra

module MyApp.Root exposing (..)

import Json.Decode as Decode exposing (Decoder)
import Json.Decode.Pipeline exposing (required, optional)

type alias Root =
    {
    id : String
    ,     name : String
    ,     email : String
    ,     age : Float
    ,     score : Float
    ,     active : Bool
    }

decoder : Decoder Root
decoder =
    Decode.succeed Root
        |> required "id" Decode.string
        |> required "name" Decode.string
        |> required "email" Decode.string
        |> required "age" Decode.float
        |> required "score" Decode.float
        |> required "active" Decode.bool"
`;

