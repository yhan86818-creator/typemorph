exports[`Tier2 generators — BASIC input > react-context 1`] = `
"// Required dependencies: npm install react

import React, { createContext, useContext, useState, ReactNode } from 'react';

export interface RootState {
  id: string;
  name: string;
  email: string;
  age: number;
  score: number;
  active: boolean;
}

interface RootContextType {
  state: RootState;
  updateState: (updates: Partial<RootState>) => void;
}

const RootContext = createContext<RootContextType | undefined>(undefined);

export const RootProvider = ({ children, initial }: { children: ReactNode; initial: RootState }) => {
  const [state, setState] = useState<RootState>(initial);
  const updateState = (updates: Partial<RootState>) => setState(prev => ({ ...prev, ...updates }));

  return (
    <RootContext.Provider value={{ state, updateState }}>
      {children}
    </RootContext.Provider>
  );
};

export const useRootContext = () => {
  const context = useContext(RootContext);
  if (!context) throw new Error('useRootContext must be used within RootProvider');
  return context;
};"
`;

