exports[`Tier2 generators — WITH_NULLS > c 1`] = `
"// C99+ required. cJSON dependency: https://github.com/DaveGamble/cJSON

#include <stdbool.h>
#include <stdint.h>
#include <stdlib.h>
/* cJSON — single-header JSON parser: https://github.com/DaveGamble/cJSON */
#include "cJSON.h"

typedef struct {
  char *user_id;
  char *display_name;
  char *bio; /* nullable */
  char *website; /* nullable */
  int32_t follower_count;
  bool is_verified;
} Profile;

Profile profile_from_json(const char *json_str) {
  Profile result = {0};
  cJSON *root = cJSON_Parse(json_str);
  if (!root) return result;

  cJSON *_user_id = cJSON_GetObjectItemCaseSensitive(root, "user_id");
  if (cJSON_IsString(_user_id)) result.user_id = _user_id->valuestring;
  cJSON *_display_name = cJSON_GetObjectItemCaseSensitive(root, "display_name");
  if (cJSON_IsString(_display_name)) result.display_name = _display_name->valuestring;
  cJSON *_bio = cJSON_GetObjectItemCaseSensitive(root, "bio");
  if (cJSON_IsString(_bio)) result.bio = _bio->valuestring;
  cJSON *_website = cJSON_GetObjectItemCaseSensitive(root, "website");
  if (cJSON_IsString(_website)) result.website = _website->valuestring;
  cJSON *_follower_count = cJSON_GetObjectItemCaseSensitive(root, "follower_count");
  if (cJSON_IsNumber(_follower_count)) result.follower_count = (int32_t)_follower_count->valuedouble;
  cJSON *_is_verified = cJSON_GetObjectItemCaseSensitive(root, "is_verified");
  if (cJSON_IsBool(_is_verified)) result.is_verified = cJSON_IsTrue(_is_verified);

  cJSON_Delete(root);
  return result;
}"
`;

exports[`Tier2 generators — WITH_NULLS > cpp 1`] = `
"// C++17 required. nlohmann/json: https://github.com/nlohmann/json

#include <string>
#include <optional>
#include <cstdint>
/* nlohmann/json — header-only JSON: https://github.com/nlohmann/json */
#include <nlohmann/json.hpp>

struct Profile {
  std::string user_id;
  std::string display_name;
  std::optional<std::string> bio;
  std::optional<std::string> website;
  int64_t follower_count;
  bool is_verified;

  static Profile from_json(const nlohmann::json& j) {
    Profile obj;
    obj.user_id = j.at("user_id").get<std::string>();
    obj.display_name = j.at("display_name").get<std::string>();
    if (j.contains("bio") && !j["bio"].is_null())
      obj.bio = j["bio"].get<std::string>();
    if (j.contains("website") && !j["website"].is_null())
      obj.website = j["website"].get<std::string>();
    obj.follower_count = j.at("follower_count").get<int64_t>();
    obj.is_verified = j.at("is_verified").get<bool>();
    return obj;
  }

  nlohmann::json to_json() const {
    return {
      {"user_id", user_id},
      {"display_name", display_name},
      {"bio", bio.has_value() ? nlohmann::json(*bio) : nlohmann::json(nullptr)},
      {"website", website.has_value() ? nlohmann::json(*website) : nlohmann::json(nullptr)},
      {"follower_count", follower_count},
      {"is_verified", is_verified},
    };
  }
};"
`;

