export interface RootState {
  id: string;
  name: string;
  email: string;
  age: number;
  score: number;
  active: boolean;
}

export const useRootStore = defineStore('root', {
  state: (): RootState => ({
    id: '',
    name: '',
    email: '',
    age: 0,
    score: 0,
    active: false,
  }),
  actions: {
    update(data: Partial<RootState>) {
      Object.assign(this, data);
    },
    reset() {
      this.$reset();
    }
  }
});"
