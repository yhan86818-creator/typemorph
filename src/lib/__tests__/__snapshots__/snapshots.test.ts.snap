exports[`Tier1 generators — DISCRIMINATED (discriminated union) > zod 1`] = `
"// Required dependencies: npm install zod

import { z } from "zod";

export const postItemTextSchema = z.object({
  type: z.literal("text"),
  content: z.string(),
  char_count: z.number(),
});
export type PostItemText = z.infer<typeof postItemTextSchema>;

export const postItemImageSchema = z.object({
  type: z.literal("image"),
  url: z.string().url(),
  width: z.number(),
  height: z.number(),
});
export type PostItemImage = z.infer<typeof postItemImageSchema>;

export const postItemVideoSchema = z.object({
  type: z.literal("video"),
  url: z.string().url(),
  duration_sec: z.number(),
});
export type PostItemVideo = z.infer<typeof postItemVideoSchema>;

export const postItemSchema = z.discriminatedUnion("type", [
  postItemTextSchema,
  postItemImageSchema,
  postItemVideoSchema,
]);
export type PostItem = z.infer<typeof postItemSchema>;

export const postSchema = z.array(postItemSchema);
export type Post = z.infer<typeof postSchema>;"
`;

